# Copy to .env.local and fill in. Never commit real values.
# Variables starting with NEXT_PUBLIC_ are sent to the browser; everything else stays on the server.

# --- Site ------------------------------------------------------------------
# Public base URL (no trailing slash). Real domain is set in Phase 12.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared time zone for daily content and calendar days (IANA name).
NEXT_PUBLIC_SHARED_TIMEZONE=America/Toronto
# Set to 1 to serve /styleguide in a production build (it is always on in dev).
ENABLE_STYLEGUIDE=

# --- Admin allowlist (exactly two emails, comma-separated) — Phase 2/3 ----
# Partner A (Nurat) first, then partner B (Afeez). Read by `npm run db:seed` and the tests.
ADMIN_EMAILS=partner-a@example.com,partner-b@example.com
# DEV PROJECT ONLY: `npm run db:seed` sets these passwords and the Playwright tests sign in with them.
# Leave empty for production — there, each partner signs in with a magic link.
ADMIN_PASSWORD_A=
ADMIN_PASSWORD_B=

# --- Supabase — Phase 2 (Project Settings → API) ----------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never expose to the browser, never paste into chat.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend) — Phase 9/10 -------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Lawal's diary <hello@example.com>"

# --- Cloudflare Turnstile — Phase 10 --------------------------------------
# Protects the public foundation form. Required in production (the form refuses submissions without it).
# For development and the e2e tests, Cloudflare's always-pass TEST keys work:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Upstash rate limiting — Phase 10 -------------------------------------
# 5 foundation applications per IP per hour. Without these, an in-memory limit is used (fine locally; per-instance
# on Vercel, so set them before launch).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Vercel Cron — Phase 9 -------------------------------------------------
# Random string; Vercel sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# --- Web push (optional) — v1.2 --------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@example.com
