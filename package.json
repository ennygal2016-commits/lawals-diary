{
  "name": "lawals-diary",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "build": "npm run clean && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:db": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/seed.mts",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run test",
    "lighthouse": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.5",
    "@react-email/components": "^1.0.12",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@tiptap/extensions": "^3.33.1",
    "@tiptap/pm": "^3.33.1",
    "@tiptap/react": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.41.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "heic-convert": "^2.1.0",
    "lucide-react": "^1.70.0",
    "next": "^15.5.29",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "resend": "^6.38.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/heic-convert": "^2.1.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "lighthouse": "^13.6.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9",
    "vitest": "^5.1.0"
  }
}
